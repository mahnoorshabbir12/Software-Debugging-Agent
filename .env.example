# TestSprite AI Testing Platform
TESTSPRITE_API_KEY=your_testsprite_api_key_here
TESTSPRITE_PROJECT_ID=your_testsprite_project_id_here

# LLM Providers (For future modules)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Gateway (LiteLLM Proxy — Module 28)
# The gateway sits between the application and LLM providers, handling routing,
# failover, and caching. See litellm_config.yaml for provider configuration.
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-debugger-dev
LITELLM_MASTER_KEY=sk-debugger-dev
LLM_MODEL_NAME=debugger/main-model


# Vector Database (For future modules)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Observability (Module 21)
# Master switch for tracing + metric persistence (structured logging stays on regardless).
OBSERVABILITY_ENABLED=true
# Logging: DEBUG/INFO/WARNING/ERROR and JSON vs. human-readable console output.
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_LOG_JSON=true
# Fraction of runs to trace (1.0 = all). Long payloads are truncated to this many chars.
OBSERVABILITY_SAMPLE_RATE=1.0
OBSERVABILITY_MAX_FIELD_LEN=4000
# Redact prompt/message text before persisting or streaming (privacy).
OBSERVABILITY_REDACT_PROMPTS=false

# Optional: LangSmith managed tracing (zero-code deep traces). Leave disabled to
# use only the built-in self-hosted observability.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=autonomous-debugger

# GitHub CI/CD Integration
GITHUB_TOKEN=your_token_here